# pi-read: shipped defaults for the never-share list. DO NOT EDIT THIS FILE.
#
# pi-share reads only /usr/local/etc/pi-read/never-share.list, which install.sh creates from this
# file when no list is installed yet. Edit that one instead:
#
#   sudoedit /usr/local/etc/pi-read/never-share.list
#
# Compare it with these defaults:  diff -u never-share.defaults /usr/local/etc/pi-read/never-share.list
# Restore these defaults:          ./install.sh --reset-never-share
#
# Syntax: one absolute path per line; * ? [...] work as in the shell (* also crosses /). An entry
# refuses the paths it matches and everything below them. Blank lines and # comments are ignored.
# /proc, /sys, /dev and swap devices are always refused, whatever this list says.

# Password hashes and their backups
/etc/shadow*
/etc/gshadow*
/etc/security/opasswd*
/var/backups/*shadow*

# SSH host private keys
/etc/ssh/ssh_host_*_key

# TLS private keys
/etc/ssl/private
/etc/letsencrypt/archive
/etc/letsencrypt/live
/etc/pki/tls/private

# Other service secrets
/etc/krb5.keytab
/etc/ipsec.secrets
/etc/ppp/*-secrets

# Root's home folder
/root

# Stored credentials and disk keys
/etc/credstore
/etc/credstore.encrypted
/etc/cryptsetup-keys.d
/var/lib/systemd/credential.secret
/run/credentials

# Network secrets
/etc/wireguard
/etc/NetworkManager/system-connections
/run/NetworkManager/system-connections
/etc/wpa_supplicant
/var/lib/iwd
/var/lib/bluetooth

# The package signing keyring
/etc/pacman.d/gnupg

# Directory service and virtualisation state
/var/lib/samba/private
/var/lib/sss
/etc/libvirt/secrets
/var/lib/tailscale
/etc/kubernetes
/var/lib/kubelet

# Memory contents (swap devices are refused through /proc/swaps)
/var/lib/systemd/coredump
/swapfile

# Container storage
/var/lib/docker
/var/lib/containers
