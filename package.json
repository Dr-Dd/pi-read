{
	"name": "pi-read",
	"version": "0.1.0",
	"private": true,
	"description": "pi extension: time-limited, read-only copies of root-only files, approved with sudo",
	"type": "module",
	"license": "WTFPL",
	"keywords": [
		"pi-package"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"test": "node --test 'tests/**/*.test.ts'",
		"test:sh": "bats tests/bash"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.7",
		"@earendil-works/pi-coding-agent": "1.5.2",
		"@types/node": "^22.20.5",
		"bats": "1.13.0",
		"typebox": "1.3.27",
		"typescript": "5.9.3"
	}
}
